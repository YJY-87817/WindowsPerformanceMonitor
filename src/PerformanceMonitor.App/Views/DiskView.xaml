<UserControl x:Class="PerformanceMonitor.App.Views.DiskView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:PerformanceMonitor.App.Controls">
    <StackPanel>
        <TextBlock Text="{Binding Title}" Style="{StaticResource PageTitle}" />
        <TextBlock Text="{Binding ModuleStatus}" Foreground="{Binding ModuleKind, Converter={StaticResource StatusBrush}}" Style="{StaticResource ModuleStatus}" />
        <ItemsControl ItemsSource="{Binding Charts}" ItemTemplate="{StaticResource TrendChartCard}" Focusable="False" Margin="0,4,0,0">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
        </ItemsControl>
        <TextBlock Text="容量" Style="{StaticResource SectionTitle}" />
        <DataGrid ItemsSource="{Binding Capacity}" AutomationProperties.Name="磁碟容量">
            <DataGrid.Columns>
                <DataGridTextColumn Header="磁碟" Binding="{Binding Drive}" Width="60" />
                <DataGridTextColumn Header="標籤" Binding="{Binding Label}" Width="110" />
                <DataGridTextColumn Header="總量" Binding="{Binding Total}" Width="100" />
                <DataGridTextColumn Header="已使用" Binding="{Binding Used}" Width="100" />
                <DataGridTextColumn Header="可用" Binding="{Binding Free}" Width="100" />
                <DataGridTemplateColumn Header="使用率（刻線為告警門檻）" Width="190">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Grid Margin="4,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" MinWidth="52" />
                                </Grid.ColumnDefinitions>
                                <controls:BarGaugeControl Ratio="{Binding UsedRatio}" MarkerRatio="{Binding MarkerRatio}" IsAlert="{Binding OverThreshold}"
                                                          Height="16" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="{Binding UsedPercent}" TextAlignment="Right" Margin="8,0,0,0" VerticalAlignment="Center" />
                            </Grid>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="狀態" Width="170"><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding StatusText}" Foreground="{Binding Kind, Converter={StaticResource StatusBrush}}" Margin="4,2" /></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                <DataGridTextColumn Header="原因" Binding="{Binding Message}" Width="*" />
            </DataGrid.Columns>
        </DataGrid>
        <TextBlock Text="I/O" Style="{StaticResource SectionTitle}" />
        <TextBlock Text="延遲是計數器層級的平均服務時間；邏輯與實體磁碟是同一份 I/O 的兩種角度，不可相加。" Style="{StaticResource Secondary}" Margin="0,0,0,6" />
        <DataGrid ItemsSource="{Binding Io}" AutomationProperties.Name="磁碟 I/O">
            <DataGrid.Columns>
                <DataGridTextColumn Header="種類" Binding="{Binding Scope}" Width="50" />
                <DataGridTextColumn Header="磁碟" Binding="{Binding Disk}" Width="90" />
                <DataGridTextColumn Header="讀取" Binding="{Binding Read}" Width="95" />
                <DataGridTextColumn Header="寫入" Binding="{Binding Write}" Width="95" />
                <DataGridTextColumn Header="IOPS 讀／寫" Binding="{Binding Iops}" Width="95" />
                <DataGridTextColumn Header="延遲 讀／寫" Binding="{Binding Latency}" Width="120" />
                <DataGridTextColumn Header="忙碌率" Binding="{Binding Busy}" Width="70" />
                <DataGridTemplateColumn Header="狀態" Width="170"><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding StatusText}" Foreground="{Binding Kind, Converter={StaticResource StatusBrush}}" Margin="4,2" /></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                <DataGridTextColumn Header="原因" Binding="{Binding Message}" Width="*" />
            </DataGrid.Columns>
        </DataGrid>
    </StackPanel>
</UserControl>
