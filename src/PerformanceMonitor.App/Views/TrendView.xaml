<UserControl x:Class="PerformanceMonitor.App.Views.TrendView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:PerformanceMonitor.App.Controls">
    <StackPanel>
        <TextBlock Text="{Binding Title}" Style="{StaticResource PageTitle}" />
        <TextBlock Text="{Binding RangeText}" Style="{StaticResource Secondary}" Margin="0,0,0,12" />
        <ItemsControl ItemsSource="{Binding Charts}" Focusable="False">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Style="{StaticResource Card}" Width="440">
                        <StackPanel>
                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="14" />
                            <controls:TrendChartControl Chart="{Binding}" Height="170" Margin="0,6,0,4" AutomationProperties.Name="{Binding Title}" />
                            <ItemsControl ItemsSource="{Binding Series}" Focusable="False">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,14,0">
                                            <Rectangle Width="12" Height="3" Fill="{Binding ColorIndex, Converter={StaticResource SeriesColor}}" VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding Name}" Margin="4,0,4,0" />
                                            <TextBlock Text="{Binding CurrentText}" FontWeight="SemiBold" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </StackPanel>
</UserControl>
