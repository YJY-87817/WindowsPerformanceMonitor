<UserControl x:Class="PerformanceMonitor.App.Views.StatusView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <DataTemplate x:Key="RowTemplate">
            <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="0,6">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="160" />
                        <ColumnDefinition Width="170" />
                        <ColumnDefinition Width="200" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="{Binding Module}" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding Device}" Style="{StaticResource Secondary}" />
                    </StackPanel>
                    <TextBlock Grid.Column="1" Text="{Binding StatusText}" Foreground="{Binding Kind, Converter={StaticResource StatusBrush}}" />
                    <TextBlock Grid.Column="2" Text="{Binding ErrorCode}" Style="{StaticResource Secondary}" />
                    <TextBlock Grid.Column="3" Text="{Binding Message}" TextWrapping="Wrap" />
                </Grid>
            </Border>
        </DataTemplate>
        <DataTemplate x:Key="LineTemplate">
            <TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="0,2" />
        </DataTemplate>
    </UserControl.Resources>

    <StackPanel>
        <TextBlock Text="{Binding Title}" Style="{StaticResource PageTitle}" />

        <TextBlock Text="啟動檢查" Style="{StaticResource SectionTitle}" />
        <ItemsControl ItemsSource="{Binding StartupLines}" ItemTemplate="{StaticResource LineTemplate}" />

        <TextBlock Text="CSV 寫入" Style="{StaticResource SectionTitle}" />
        <TextBlock Text="{Binding StorageText}" Foreground="{Binding StorageKind, Converter={StaticResource StatusBrush}}" TextWrapping="Wrap" />

        <TextBlock Text="各模組狀態" Style="{StaticResource SectionTitle}" />
        <ItemsControl ItemsSource="{Binding Modules}" ItemTemplate="{StaticResource RowTemplate}" />

        <TextBlock Text="不正常的裝置" Style="{StaticResource SectionTitle}" />
        <ItemsControl ItemsSource="{Binding DeviceIssues}" ItemTemplate="{StaticResource RowTemplate}" />

        <TextBlock Text="最近告警（最多 5 筆）" Style="{StaticResource SectionTitle}" />
        <ItemsControl ItemsSource="{Binding RecentAlerts}" ItemTemplate="{StaticResource LineTemplate}" />
    </StackPanel>
</UserControl>
