<UserControl x:Class="PerformanceMonitor.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <TextBlock Text="{Binding Title}" Style="{StaticResource PageTitle}" />
        <TextBlock Text="{Binding Notice}" Style="{StaticResource Secondary}" Margin="0,0,0,10" />

        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
            <Button Content="儲存並重新啟動(_V)" Command="{Binding SaveCommand}" Margin="0" AutomationProperties.Name="儲存並重新啟動" />
            <Button Content="復原(_R)" Command="{Binding RevertCommand}" AutomationProperties.Name="復原" />
            <Button Content="填入預設值(_D)" Command="{Binding DefaultsCommand}" AutomationProperties.Name="填入預設值" />
        </StackPanel>
        <TextBlock Text="{Binding Message}" TextWrapping="Wrap" Margin="0,0,0,6" />
        <Border Background="{StaticResource BannerBrush}" Padding="10,6" Margin="0,0,0,8"
                Visibility="{Binding HasErrors, Converter={StaticResource BoolToVisibility}}">
            <ItemsControl ItemsSource="{Binding Errors}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" Foreground="{StaticResource ErrorBrush}" TextWrapping="Wrap" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Border>

        <ItemsControl ItemsSource="{Binding Sections}" Focusable="False">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,6" />
                            <ItemsControl ItemsSource="{Binding Fields}" Focusable="False">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="250" />
                                                <ColumnDefinition Width="260" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Label}" VerticalAlignment="Center" TextWrapping="Wrap" />
                                            <ContentControl Grid.Column="1" Content="{Binding}" Focusable="False">
                                                <ContentControl.Style>
                                                    <Style TargetType="ContentControl">
                                                        <Setter Property="ContentTemplate">
                                                            <Setter.Value>
                                                                <DataTemplate>
                                                                    <TextBox Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{Binding Label}" Padding="2" />
                                                                </DataTemplate>
                                                            </Setter.Value>
                                                        </Setter>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Kind}" Value="Boolean">
                                                                <Setter Property="ContentTemplate">
                                                                    <Setter.Value>
                                                                        <DataTemplate>
                                                                            <CheckBox IsChecked="{Binding Checked}" AutomationProperties.Name="{Binding Label}" VerticalAlignment="Center" />
                                                                        </DataTemplate>
                                                                    </Setter.Value>
                                                                </Setter>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Kind}" Value="List">
                                                                <Setter Property="ContentTemplate">
                                                                    <Setter.Value>
                                                                        <DataTemplate>
                                                                            <TextBox Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{Binding Label}"
                                                                                     AcceptsReturn="True" TextWrapping="Wrap" MinHeight="44" Padding="2" />
                                                                        </DataTemplate>
                                                                    </Setter.Value>
                                                                </Setter>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Kind}" Value="Choice">
                                                                <Setter Property="ContentTemplate">
                                                                    <Setter.Value>
                                                                        <DataTemplate>
                                                                            <ComboBox ItemsSource="{Binding Options}" SelectedItem="{Binding Text}" AutomationProperties.Name="{Binding Label}" />
                                                                        </DataTemplate>
                                                                    </Setter.Value>
                                                                </Setter>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </ContentControl.Style>
                                            </ContentControl>
                                            <TextBlock Grid.Column="2" Text="{Binding Hint}" Style="{StaticResource Secondary}" Margin="10,0,0,0" VerticalAlignment="Center" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </StackPanel>
</UserControl>
