<UserControl x:Class="PerformanceMonitor.App.Views.ProcessView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:PerformanceMonitor.App.Controls">
    <StackPanel>
        <TextBlock Text="{Binding Title}" Style="{StaticResource PageTitle}" />
        <TextBlock Text="{Binding ModuleStatus}" Foreground="{Binding ModuleKind, Converter={StaticResource StatusBrush}}" Style="{StaticResource ModuleStatus}" />
        <TextBlock Text="{Binding Note}" Style="{StaticResource Secondary}" Margin="0,0,0,8" />
        <DataGrid ItemsSource="{Binding Processes}" AutomationProperties.Name="程序">
            <DataGrid.Columns>
                <DataGridTextColumn Header="排名" Binding="{Binding Rank}" Width="50" />
                <DataGridTextColumn Header="名稱" Binding="{Binding Name}" Width="220" />
                <DataGridTextColumn Header="PID" Binding="{Binding Pid}" Width="80" />
                <DataGridTextColumn Header="Working Set" Binding="{Binding WorkingSet}" Width="110" />
                <DataGridTextColumn Header="啟動時間" Binding="{Binding StartTime}" Width="*" />
            </DataGrid.Columns>
        </DataGrid>
        <TextBlock Text="{Binding CountsText}" Style="{StaticResource Secondary}" />
    </StackPanel>
</UserControl>
