<Project Sdk="Microsoft.NET.Sdk">

  <!-- WPF 桌面程式：Views、ViewModels 與 DI 組裝（Composition Root）。 -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <AssemblyName>PerformanceMonitor</AssemblyName>
    <RootNamespace>PerformanceMonitor.App</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\PerformanceMonitor.Application\PerformanceMonitor.Application.csproj" />
    <ProjectReference Include="..\PerformanceMonitor.Infrastructure\PerformanceMonitor.Infrastructure.csproj" />
    <ProjectReference Include="..\PerformanceMonitor.Presentation\PerformanceMonitor.Presentation.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" />
  </ItemGroup>

</Project>
