<Project>
  <!--
    集中管理套件版本。新增套件前須符合 docs/decisions/0003-dependencies.md 的分類原則，
    並在該文件列出用途。
  -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <!-- 執行期：Microsoft 官方套件 -->
  <ItemGroup>
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.15" />
    <PackageVersion Include="Microsoft.Extensions.Hosting" Version="10.0.15" />
  </ItemGroup>

  <!-- 執行期：.NET Foundation 套件 -->
  <ItemGroup>
    <PackageVersion Include="CommunityToolkit.Mvvm" Version="8.4.2" />
  </ItemGroup>

  <!-- 只用於測試，不進入發行檔 -->
  <ItemGroup>
    <PackageVersion Include="coverlet.collector" Version="6.0.4" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.0.1" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.5" />
  </ItemGroup>
</Project>
